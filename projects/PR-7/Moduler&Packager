def factorial():

    try:
        num = int(input("\nEnter a number: "))

        if num < 0:
            print("Factorial does not exist for negative numbers.")

        else:
            print(f"Factorial: {math.factorial(num)}")

    except ValueError:
        print("Invalid Input!")

def compound_interest():

    try:
        principal = float(input("\nEnter principal amount: "))
        rate = float(input("Enter rate of interest (in %): "))
        time = float(input("Enter time (in years): "))

        amount = principal * ((1 + rate / 100) ** time)

        print(f"Compound Interest: {amount:.2f}")

    except ValueError:
        print("Invalid Input!")

def trigonometry():

    try:
        degree = float(input("\nEnter angle (in degrees): "))

        radian = math.radians(degree)

        print(f"\nSin({degree}) = {math.sin(radian):.4f}")
        print(f"Cos({degree}) = {math.cos(radian):.4f}")
        print(f"Tan({degree}) = {math.tan(radian):.4f}")

    except ValueError:
        print("Invalid Input!")

def area():

    while True:

        print("\nArea of Geometric Shapes")
        print("1. Circle")
        print("2. Rectangle")
        print("3. Triangle")
        print("4. Back")

        choice = input("\nEnter your choice: ")

        match choice:

            case "1":

                try:
                    radius = float(input("Enter radius: "))
                    area = math.pi * radius * radius
                    print(f"Area of Circle: {area:.2f}")

                except ValueError:
                    print("Invalid Input!")

            case "2":

                try:
                    length = float(input("Enter length: "))
                    width = float(input("Enter width: "))

                    print(f"Area of Rectangle: {length * width:.2f}")

                except ValueError:
                    print("Invalid Input!")

            case "3":

                try:
                    base = float(input("Enter base: "))
                    height = float(input("Enter height: "))

                    print(f"Area of Triangle: {(base * height) / 2:.2f}")

                except ValueError:
                    print("Invalid Input!")

            case "4":
                break

            case _:
