# ---------------- MATH MODULE ----------------

def factorial():
    try:
        num = int(input("Enter a Number : "))
        print("Factorial :", math.factorial(num))
    except ValueError:
        print("Invalid Input")


def compound_interest():
    try:
        p = float(input("Principal : "))
        r = float(input("Rate (%) : "))
        t = float(input("Time (Years) : "))

        amount = p * ((1 + r / 100) ** t)
        ci = amount - p

        print("Compound Interest :", round(ci, 2))
        print("Total Amount :", round(amount, 2))

    except ValueError:
        print("Invalid Input")


def trigonometry():
    try:
        degree = float(input("Enter Angle : "))
        rad = math.radians(degree)

        print("Sin :", round(math.sin(rad), 4))
        print("Cos :", round(math.cos(rad), 4))
        print("Tan :", round(math.tan(rad), 4))

    except ValueError:
        print("Invalid Input")


def area():
    while True:

        print("\nArea Menu")
        print("1. Circle")
        print("2. Rectangle")
        print("3. Triangle")
        print("4. Back")

        ch = input("Choice : ")

        match ch:

            case "1":
                r = float(input("Radius : "))
                print("Area :", round(math.pi * r * r, 2))

            case "2":
                l = float(input("Length : "))
                b = float(input("Breadth : "))
                print("Area :", l * b)

            case "3":
                b = float(input("Base : "))
                h = float(input("Height : "))
                print("Area :", (b * h) / 2)

            case "4":
                break

            case _:
                print("Invalid Choice")


