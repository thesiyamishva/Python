def generate_multiple_uuids():

    try:
        count = int(input("\nEnter how many UUIDs you want to generate: "))

        if count <= 0:
            print("Please enter a positive number.")
            return

        print(f"\nGenerating {count} UUID(s):\n")

        for i in range(1, count + 1):
            print(f"{i}. {uuid.uuid4()}")

    except ValueError:
        print("Invalid Input!")

FILENAME = "sample.txt"

def create_file():

    if os.path.exists(FILENAME):
        print("\nFile already exists.")

    else:
        with open(FILENAME, "w") as file:
            file.write("Welcome to Multi-Utility Toolkit!\n")

        print("\nFile created successfully.")

def read_file():

    if os.path.exists(FILENAME):

        with open(FILENAME, "r") as file:

            print("\n----- File Content -----")
            print(file.read())

    else:
        print("\nFile not found.")

def append_file():

    if os.path.exists(FILENAME):

        text = input("\nEnter text to append: ")

        with open(FILENAME, "a") as file:

            file.write(text + "\n")

        print("\nText appended successfully.")

    else:
        print("\nFile not found.")

def delete_file():

    if os.path.exists(FILENAME):

        os.remove(FILENAME)

        print("\nFile deleted successfully.")

    else:
        print("\nFile not found.")

def file_info():

    if os.path.exists(FILENAME):

        print("\n----- File Information -----")
        print("File Name :", FILENAME)
        print("File Size :", os.path.getsize(FILENAME), "bytes")
        print("Absolute Path :", os.path.abspath(FILENAME))

    else:
        print("\nFile not found.")

