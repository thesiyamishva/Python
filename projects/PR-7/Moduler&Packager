def display_current_datetime():

    now = datetime.now()

    print("\nCurrent Date and Time:", now.strftime("%Y-%m-%d %H:%M:%S"))

def date_difference():

    try:
        date1 = input("\nEnter the first date (YYYY-MM-DD): ")
        date2 = input("Enter the second date (YYYY-MM-DD): ")

        d1 = datetime.strptime(date1, "%Y-%m-%d")
        d2 = datetime.strptime(date2, "%Y-%m-%d")

        diff = abs((d2 - d1).days)

        print(f"Difference: {diff} days")

    except ValueError:
        print("Invalid date format!")

def format_date():

    try:
        date = input("\nEnter date (YYYY-MM-DD): ")

        d = datetime.strptime(date, "%Y-%m-%d")

        print("\nChoose Format")
        print("1. DD/MM/YYYY")
        print("2. Month DD, YYYY")
        print("3. Day Month Year")

        choice = input("Enter your choice: ")

        match choice:

            case "1":
                print(d.strftime("%d/%m/%Y"))

            case "2":
                print(d.strftime("%B %d, %Y"))

            case "3":
                print(d.strftime("%d %B %Y"))

            case _:
                print("Invalid Choice!")

    except ValueError:
        print("Invalid date!")

def stopwatch():

    input("\nPress ENTER to start Stopwatch...")

    start = time.time()

    input("Press ENTER to stop Stopwatch...")

    end = time.time()

    print(f"Elapsed Time: {end - start:.2f} seconds")

def countdown():

    try:
        seconds = int(input("\nEnter countdown time (seconds): "))

        while seconds > 0:

            print(seconds)

            time.sleep(1)

            seconds -= 1

        print("Time's Up!")

    except ValueError:

        print("Invalid Input!")

