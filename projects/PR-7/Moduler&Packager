def generate_random_number():

    try:
        start = int(input("\nEnter starting number: "))
        end = int(input("Enter ending number: "))

        print(f"\nGenerated Random Number: {random.randint(start, end)}")

    except ValueError:
        print("Invalid Input!")

def generate_random_list():

    try:
        size = int(input("\nEnter list size: "))
        start = int(input("Enter minimum value: "))
        end = int(input("Enter maximum value: "))

        numbers = [random.randint(start, end) for _ in range(size)]

        print("\nGenerated Random List:")
        print(numbers)

    except ValueError:
        print("Invalid Input!")

def generate_password():

    try:
        length = int(input("\nEnter password length: "))

        if length < 4:
            print("Password length should be at least 4.")
            return

        characters = (
            string.ascii_letters +
            string.digits +
            string.punctuation
        )

        password = "".join(random.choice(characters) for _ in range(length))

        print(f"\nGenerated Password: {password}")

    except ValueError:
        print("Invalid Input!")

